# Copy this file to .env and fill in real values. Never commit .env itself.

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Create a free account at https://resend.com, generate a key at
# https://resend.com/api-keys and paste it here.
RESEND_API_KEY=

# The "From" address for all outgoing emails (must be a verified domain on Resend).
CONTACT_FROM_EMAIL=noreply@cosmictestlab.com

# TESTING ONLY: routes every contact/career form submission to this one inbox.
# Remove this line once delivery is confirmed in production.
# TEST_RECIPIENT_EMAIL=

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Get this from: Supabase dashboard → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# ─── Careers Admin Auth ────────────────────────────────────────────────────────
# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAREERS_JWT_SECRET=

# Super admin account — seeded automatically on first boot if not already present.
# Change the password from the admin panel after first login.
CAREERS_SUPERADMIN_EMAIL=anitha@cosmictest.com
CAREERS_SUPERADMIN_PASSWORD=ChangeMe@123
