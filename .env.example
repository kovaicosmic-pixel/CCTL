# Copy this file to .env and fill in real values. Never commit .env itself.

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Create a free account at https://resend.com, generate a key at
# https://resend.com/api-keys and paste it here.
RESEND_API_KEY=

# The "From" address for all outgoing emails (must be a verified domain on Resend).
CONTACT_FROM_EMAIL=noreply@cosmictestlab.com

# TESTING ONLY: routes every contact/career form submission to this one inbox.
# Remove this line once delivery is confirmed in production.
# TEST_RECIPIENT_EMAIL=

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Use the SESSION POOLER string: Supabase dashboard → Connect → "Session pooler".
# (The direct db.xxxx.supabase.co address is IPv6-only and fails on most
#  networks/VPSs with "getaddrinfo ENOTFOUND".) URL-encode special characters
#  in the password, e.g. @ → %40, # → %23.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Careers Admin Auth ────────────────────────────────────────────────────────
# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAREERS_JWT_SECRET=

# Super admin account — seeded automatically on first boot if not already present.
# Change the password from the admin panel after first login.
CAREERS_SUPERADMIN_EMAIL=anitha@cosmictestlab.com
CAREERS_SUPERADMIN_PASSWORD=ChangeMe@123
