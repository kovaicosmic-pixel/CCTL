# Copy this file to .env and fill in real values. Never commit .env itself.

# Resend API key — create a free account at https://resend.com, then
# generate a key at https://resend.com/api-keys and paste it here.
RESEND_API_KEY=

# The "from" address the contact-form emails are sent from.
# Until a domain is verified in Resend (Domains -> Add Domain, then add the
# SPF/DKIM DNS records it gives you), you can only send from Resend's shared
# testing address below. Once cosmictestlab.com (or whatever domain is
# finalized) is verified, change this to e.g. "CCTL Website <no-reply@cosmictestlab.com>".
CONTACT_FROM_EMAIL="CCTL Website <onboarding@resend.dev>"

# Optional, testing only: when set, EVERY contact-form submission is sent to
# this one address instead of the real per-location inbox — so you can
# confirm delivery works using a mailbox you can actually check, without
# needing access to the real kovaiemc@ / emc@ inboxes. Delete this line (or
# leave it blank) once delivery is confirmed, so real submissions route to
# the real location-based addresses again.
TEST_RECIPIENT_EMAIL=
